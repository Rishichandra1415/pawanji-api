PORT=4000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pawanji

# Public path prefix used behind nginx
API_PREFIX=/api

# Public URL of this API (used for photo links inside emails)
PUBLIC_API_URL=http://localhost:4000/api
# Comma separated allowed origins, e.g. https://pawanjaiswal.in,https://admin.pawanjaiswal.in
CORS_ORIGINS=

# Admin login
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# First admin user (created automatically only when admin_users table is empty)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Gmail SMTP (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Office of Pawan Jaiswal <your-gmail@gmail.com>"

# Uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5
UPLOAD_VIDEO_MAX_MB=100
